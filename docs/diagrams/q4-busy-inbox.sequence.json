      },
      {
        "id": "late",
        "label": "轮结束后的晚到事件",
        "focus": [
          "tool",
          "session",
          "runner"
        ],
        "note": "轮已结束的异步结果由外层会话表接：空闲开新一轮，忙则排到本轮末尾，按 request_id 对齐来源。"
      }
    ]
  },
